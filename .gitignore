# Sensitive Google Data
credentials.json
token.json
config/credentials.json
config/token.json
!config/credentials.example.json
!config/token.example.json
MCP/google/*.pickle
MCP/google/*.json

# History and Workspaces (Avoid leaking IDE history and browser states)
history/
workspace/
browser_data/
.system_generated/

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
env.bak/
venv.bak/

# Scratch testing files (Don't push random test scripts)
scratch/
scratch_test_cdp.py
scratch_test_visible.py
test_cdp.py
play_song.py

# IDE / OS
.vscode/
.idea/
.DS_Store
