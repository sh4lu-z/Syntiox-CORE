# Syntiox CORE Environment Variables Example

# ==========================================
# Core AI Model Settings (Cloud - Google)
# ==========================================
LLM_PROVIDER=google
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_MODEL=gemma-4-31b-it
BROWSER_MODEL=qwen/qwen3.8-27b
VISION_ENABLED=false

# ==========================================
# Fast Hybrid Routing & Summary (Groq)
# ==========================================
# Supports multiple comma-separated keys for auto-rotation: key1,key2
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ==========================================
# External MCP Tools & API Keys
# ==========================================
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
WOLFRAM_ALPHA_APPID=your_wolfram_alpha_appid_here

